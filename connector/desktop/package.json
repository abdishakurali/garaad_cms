{
  "name": "franchisetech-connector-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "rm -rf dist && mkdir -p dist/src && cp index.html dist/index.html && cp src/main.js src/styles.css dist/src/",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "build:windows-gnu": "tauri build --bundles nsis --target x86_64-pc-windows-gnu"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0"
  }
}
