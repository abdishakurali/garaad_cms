{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "franchisetech Connector",
  "version": "0.3.0",
  "identifier": "ro.franchisetech.connector",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "franchisetech Connector",
        "width": 900,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "franchisetech",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}